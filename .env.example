# Copy to .env and fill in. Never commit .env.
ALLOWED_LOGIN=you@example.com
HERDR_UID=1000
HERDR_GID=1000

# Which released version to run. Unset means the newest release.
# Pin it to roll back, e.g. HERDR_PWA_VERSION=0.1.0
# HERDR_PWA_VERSION=

# Host port for the adapter (mise dev, compose, Tailscale Serve). Default 8787.
# PORT=8787

# The rest only affect `mise dev` / `mise smoke`. Compose sets its own values.

# Herdr socket and config. mise.toml defaults both to ~/.config/herdr/.
# HERDR_SOCKET_PATH=/home/you/.config/herdr/herdr.sock
# HERDR_CONFIG_PATH=/home/you/.config/herdr/config.toml

# Interface the adapter listens on. Default 127.0.0.1. Anything else exposes
# it beyond loopback, and `mise dev` runs with auth bypassed.
# BIND_HOST=127.0.0.1

# 1 skips the Tailscale identity check. `mise dev` already sets it; set it here
# to make `mise smoke` skip the identity header too.
# DEV_BYPASS_AUTH=1
